# Copy to .env and replace the password before starting the production stack.
# Use a URL-safe password (letters, digits, hyphens, and underscores only).
POSTGRES_DB=queueflow
POSTGRES_USER=queueflow
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080
# Generate a unique, high-entropy value for every deployment; it signs access JWTs.
AUTH_SECRET_KEY=replace-with-a-unique-32-character-or-longer-auth-signing-secret
AUTH_ACCESS_TOKEN_MINUTES=30
# Set these only when explicitly running: python -m app.bootstrap_admin
# AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
